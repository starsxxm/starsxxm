movetype = U
physics = U
movehitpersist = 1
hitdefpersist = 1

[State ]
type = ChangeState
triggerall =!ishelper&&name!= "Nether" || ishelper&&root,name!= "Nether"
trigger1 = prevstateno != [1000043,1000045]
trigger1 = prevstateno != [515000,515002]
trigger2 = time || ctrl
value = ifelse(ishelper,515000,1000043)
persistent = 256
ignorehitpause = 1
