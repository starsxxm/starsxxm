;斜眼杀手状态
;本体ST固状态
;需要注意cns状态不能重复，P2StatNo也需
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;-------------------------------------
[statedef 0]
type = U
movetype = U
physics = U
movehitpersist = 1
hitdefpersist = 1

[State ]
type = ChangeState
triggerall =!ishelper&&name!= "Nether" || ishelper&&root,name!= "Nether"
trigger1 = prevstateno != [1000043,1000045]
trigger1 = prevstateno != [515000,515002]
trigger2 = time || ctrl
value = ifelse(ishelper,515000,1000043)
persistent = 256
ignorehitpause = 1

[State Nether]
Type = ChangeAnim 
Trigger1 = !IsHelper && Name = "Nether" && Anim != Var(58)
Value = var(58)
ignorehitpause = 1

[State Nether]
Type = SelfState 
Trigger1 = !Ishelper && AnimTime = 0
Value = 120
ignorehitpause = 1
