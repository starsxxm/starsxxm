[State 对应动画]
type = changeanim
trigger1 = root,alive
trigger1 = roundstate = 2
trigger1 = var(32) != 0
trigger1 = root,selfanimexist(var(32))
trigger1 = anim != var(32)
trigger1 = !movereversed || movereversed > 10
value = var(32)
ignorehitpause = 1

[State hit攻击]
type = hitdef
trigger1 = root,alive
trigger1 = roundstate = 2
trigger1 = !movereversed || movereversed > 10
trigger1 = var(32) != 0
trigger1 = root,selfanimexist(var(32))
trigger1 = anim = var(32)
attr = C,HP
hitflag = maflpd
guardflag =
priority = 2147483647
pausetime = 0,0
sparkno = -1
hitsound = -1
guard.dist = 0
numhits = 0
damage = -2147483647
fall.damage = -2147483647
fall = 1
fall.recover = 0
SuperMoveTime = 2147483647
PauseMoveTime = 2147483647
ignorehitpause = 1

[State -2]
type = null
triggerall = root,alive
triggerall = roundstate = 2
trigger1 = var(32)
trigger1 = anim = var(32)
trigger1 = movereversed = [1,10]
trigger1 = var(33) := var(32)
ignorehitpause = 1

[State %d即死型]
type = displaytoclipboard
trigger1 = ishelper
text = "%d,%d,%d,%d,pause=%d"
params = var(6),var(41),var(32),var(33),hitpausetime
ignorehitpause = 1

[State %d即死型]
type = appendtoclipboard
trigger1 = ishelper
text = "\nNum=%d,hit=%d,movereversed=%d"
params = root,numprojID(24100000+ID),(root,projhit24100000+ID=1),movereversed
ignorehitpause = 1

