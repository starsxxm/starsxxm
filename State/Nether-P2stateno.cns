[State Death]
type=destroyself
trigger1=sysvar(3)>100
ignorehitpause=1

[State 是本体的helper自毁]
type = DestroySelf
trigger1 = ishelper
trigger1 = root,name = "Nether"
ignorehitpause = 1

[state 本体脱离]
type = selfstate
trigger1 = !ishelper
trigger1 = name != "Nether"
value = 5011
ignorehitpause = 1
--------------------------------------------
[Statedef 5011];
type     = S
movetype = A
physics  = S
juggle   = 0
anim = 55555
velset   = 0,0
ctrl     = 0
sprpriority = 2

[State Death]
type = Null;;ChangeState
triggerall =!ishelper&&name!= "Nether" || ishelper&&root,name!= "Nether" || Root,Var(57) > 1
trigger1 = prevstateno != [1000043,1000045]
trigger1 = prevstateno != [515000,515002]
trigger2 = time || ctrl
value = ifelse(ishelper,515000,1000043)
persistent = 256
ignorehitpause = 1

[State Death]
type = Palfx
trigger1 = 1
time = 10
add = -200,-200,-200 
mul = 256,256,256
sinadd = 92,92,92,12
invertall = 1
color = 0

[State Nether]
type = hitby
trigger1 = 1
value = sca,na,sa,ha,aa,nt,st,ht,at,np,sp,hp,ap
value2 = sca,na,sa,ha,aa,nt,st,ht,at,np,sp,hp,ap
time = 2
ignorehitpause = 1

[State Nether]
Type = LifeSet
trigger1 = Life < LifeMax*0.05
Value = 0

[State Nether]
Type = Destroyself
Trigger1 = ishelper
IgnoreHitPause = 1 

[State Nether]
Type = ctrlset
Trigger1 = 1
value = 0
IgnoreHitPause = 1 

[State Nether]
type = defencemulset
trigger1 = 1
value = 1
ignorehitpause = 1

[State Nether]
type = turn
trigger1 = time = 0
trigger1 = p2dist x < 0
ignorehitpause = 1

[State Nether]
type = velset
trigger1 = time = 0
x = 0
y = 0

[State Nether]
type = hitfallset
trigger1 = time = 0
value = 0

[State Nether]
type = posset
trigger1 = 1
y = 0

[State Nether]
type = velset
trigger1 = time = 75
x = 0

[State Nether]
type = changeanim2
trigger1 = Anim != 55555
value = 55555

[State Nether]
type = sprpriority
trigger1 = animelem = 6
value = 1

[State Nether]
type = turn
trigger1 = animelem = 6

