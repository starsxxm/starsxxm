;---------------------------------------------------------------------------
[Statedef 777777]
movetype = A
hitdefpersist = 1
movehitpersist = 1
hitcountpersist = 1

[state 本体脱离]
type = selfstate
trigger1 = !ishelper
trigger1 = name = "Nether"
value = 120
ignorehitpause = 1

[State 是本体的helper自毁]
type = DestroySelf
trigger1 = ishelper
trigger1 = root,name = "Nether"
ignorehitpause = 1

[state 不允许离开屏幕]
type = ScreenBound
trigger1 = IsHelper
movecamera = 0,0
ignorehitpause = 1

[state 为本体的位置]
type = BindToRoot
trigger1 = IsHelper
pos = -10-random%80,-10-random%80
ignorehitpause = 1

[state 超级断言]
type = assertspecial
trigger1 = 1
flag = invisible
flag2 = noshadow
ignorehitpause = 1

;间者
[State , 間者Helper];攻擊動畫檢索間者
type = Helper
triggerall = numhelper(777777777) = 0;不存在時
triggerall = ishelper;helper執行
triggerall = playeridexist(id);消除召喚對策
trigger1 = roundstate < 3;戰鬥結束前
ID = 777777777
name = "spy-C1anim"
postype = p1
pos = 0, 500;埋在地下
stateno = 1000 * random
helpertype = normal;重要定義，若為player型則有可能被敵方代碼影響
size.xscale = 0;x軸大小
size.yscale = 0;y軸大小
keyctrl = 0;不可控
pausemovetime = 2147483647;無視時止
supermovetime = 2147483647;無視時止
ignorehitpause = 1;打擊暫停中可執行

[state 普通生命即死]
type = lifeset
trigger1 = name != "Nether"
trigger1 = !ishelper
value = 0
ignorehitpause = 1

[state 生命溢出]
type = lifeadd
trigger1 = name != "Nether"
trigger1 = !ishelper
value = -2147483647
absolute = 1
ignorehitpause = 1

[state 无敌]
type = nothitby
trigger1 = ishelper
value = SCA
ignorehitpause = 1

[state 不会被击飞]
type = HitFallDamage
trigger1 = !ishelper
trigger1 = name != "Nether"
ignorehitpause = 1

[State , 間者Helper];受擊動畫檢索間者
type = Helper
triggerall = numhelper(777777778) = 0
triggerall = ishelper
triggerall = playeridexist(id)
trigger1 = roundstate < 3
ID = 777777778
name = "spy-C2anim"
postype = p1
pos = 0, 500
stateno = 1000 * random
helpertype = normal
size.xscale = 0
size.yscale = 0
keyctrl = 0
pausemovetime = 2147483647
supermovetime = 2147483647
ignorehitpause = 1

;helper操作
;本體間者製作
[state ,攻擊動畫]
type = changeanim2
trigger1 = parent,ID = root,ID ;本體為親
trigger1 = ishelper
trigger1 =!(root,numprojID(1000045) && root,numprojID(1000046));還未製作本體間者
trigger1 =!hitpausetime
value = 10001
ignorehitpause = 1

[state ,狀態]
type = statetypeset
trigger1 = parent,ID = root,ID
trigger1 = ishelper
trigger1 =!(root,numprojID(1000045) && root,numprojID(1000046))
trigger1 =!hitpausetime;
statetype = C
movetype = A;攻擊狀態
ignorehitpause = 1

[state ,凍結獲取];取得凍結,以進行512溢出刷值
type = hitdef
trigger1 = parent,ID = root,ID
trigger1 = ishelper
trigger1 =!(root,numprojID(1000045) && root,numprojID(1000046))
trigger1 =!hitpausetime
attr = ,HP
pausetime = 4,0
numhits = 0
sparkno = -1
hitsound = -1
ignorehitpause = 1

[state 被击打]
type = HitBy
trigger1 = !ishelper
value = SCA,AA,AP,AT
time = -1
ignorehitpause = 1

[state hit攻击]
type = HitDef
trigger1 = !IsHelper && Alive
trigger1 = name != "Nether"
attr = SCA,AA,AT,AP
hitflag = MAF
damage = 0
pausetime = 10,0
sparkno = -1
hitsound = -1
ignorehitpause = 1

[state hit攻击]
type = HitDef
trigger1 = IsHelper && Root,Alive
trigger1 = Root,name != "Nether"
attr = ,NT
hitflag = MAF
id = 312312
damage = 0
pausetime = 0,10
sparkno = -1
hitsound = -1
affectteam = F
ground.velocity = 0,50
ignorehitpause = 1
fall.damage = 2147483647

[State 获取target拉P2]
type = TargetState
trigger1 = Movehit
trigger1 = Root,Alive
value = 5110
ID = 312312
ignorehitpause = 1

[State 对应动画]
type = ChangeAnim2
trigger1 = !var(32)
value = 20002
ignorehitpause = 1

[State 特效毁灭]
type = RemoveExplod
trigger1 = 1
ID = -1
ignorehitpause = 1

[state 不可控]
type = ctrlset
trigger1= !ishelper
trigger1= name !="Nether"
value = 0
ignorehitpause = 1

[state 以下都是飞行道具]
type = projectile
;triggerall = name !="Nether"
triggerall = RoundState <= 2
triggerall = ishelper && root,alive
trigger1 = gametime%50 = 0
attr = SCA,AA,AT,AP
projid = 4205
projanim = anim
projpriority = 2147483647
projscale = 0,0
projremove = 0
projremovetime = 60
hitflag = maflpd
sparkno = -1
hitsound   = -1
postype = p2
offset = 0,0
pausetime = 0,0
p1stateno = 5010
damage = -2147483647
fall.damage = -2147483647
fall = 1
fall.recover = 0
ignorehitpause = 1
SuperMoveTime = 2147483647
PauseMoveTime = 2147483647

[state 1]
type = projectile
;triggerall = name !="Nether"
triggerall = RoundState <= 2
triggerall = ishelper && root,alive
trigger1 = gametime%100 = 0
attr = SCA,AA,AT,AP
projid = 4205
projanim = random
projpriority = 2147483647
projscale = 0,0
projremove = 0
projremovetime = 60
hitflag = maflpd
sparkno = -1
hitsound   = -1
postype = p2
offset = 0,0
pausetime = 0,0
p1stateno = gametime
damage = -2147483647
fall.damage = -2147483647
fall = 1
fall.recover = 0
ignorehitpause = 1
SuperMoveTime = 2147483647
PauseMoveTime = 2147483647

[state 变量记录]
type = Varset
trigger1 = ishelper
var(20) = ifelse(Enemy(enemy,name!="Nether"),var(32)!=0,Enemy(enemy,name!="Nether"),var(32),anim)
ignorehitpause = 1

[state 变量重置]
type = Varset
trigger1 = ishelper
var(30) = ifelse(Enemy(enemy,name!="Nether"),var(32)!=0,Enemy(enemy,name!="Nether"),var(32),root,anim)
ignorehitpause = 1

