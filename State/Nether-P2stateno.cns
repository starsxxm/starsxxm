;--------------------------------
;超即死投+落下即死+生命即死+OTHK+Proj返+即死返+变数弄
;--------------------------------
[Statedef 444444]
Type = U
MoveType = U
Physics = U
VelSet = 0,0
Ctrl = 0
HitDefPerSist = 1
MoveHitPerSist = 1
HitCountPerSist = 1

[State 444444, 保险]
Type = SelfState
Trigger1 = !IsHelper
Trigger1 = Name = "Nether"
Trigger2 = IsHelper
Trigger2 = Root,Name = "Nether"
Value = 0
IgnoreHitPause = 1

[State 444444, 不可控]
Type = CtrlSet
Trigger1 = !IsHelper
Trigger1 = Name != "Nether"
Trigger2 = IsHelper
Trigger2 = Root,Name != "Nether"
Value = 0
IgnoreHitPause = 1

[State 444444, Explod消除]
Type = ReMoveExplod
Trigger1 = !IsHelper
Trigger1 = Name != "Nether"
Trigger2 = IsHelper
Trigger2 = Root,Name != "Nether"
IgnoreHitPause = 1

;间者
[State , 間者Helper];攻擊動畫檢索間者
type = Helper
triggerall = numhelper(777777777) = 0;不存在時
triggerall = ishelper;helper執行
triggerall = playeridexist(id);消除召喚對策
trigger1 = roundstate < 3;戰鬥結束前
ID = 777777777
name = "spy-C1anim"
postype = p1
pos = 0, 500;埋在地下
stateno = 1000 * random
helpertype = normal;重要定義，若為player型則有可能被敵方代碼影響
size.xscale = 0;x軸大小
size.yscale = 0;y軸大小
keyctrl = 0;不可控
pausemovetime = 2147483647;無視時止
supermovetime = 2147483647;無視時止
ignorehitpause = 1;打擊暫停中可執行

[State , 間者Helper];受擊動畫檢索間者
type = Helper
triggerall = numhelper(777777778) = 0
triggerall = ishelper
triggerall = playeridexist(id)
trigger1 = roundstate < 3
ID = 777777778
name = "spy-C2anim"
postype = p1
pos = 0, 500
stateno = 1000 * random
helpertype = normal
size.xscale = 0
size.yscale = 0
keyctrl = 0
pausemovetime = 2147483647
supermovetime = 2147483647
ignorehitpause = 1

;helper操作
;本體間者製作
[state ,攻擊動畫]
type = changeanim2
trigger1 = parent,ID = root,ID ;本體為親
trigger1 = ishelper
trigger1 =!(root,numprojID(1000045) && root,numprojID(1000046));還未製作本體間者
trigger1 =!hitpausetime
value = 10001
ignorehitpause = 1

[state ,狀態]
type = statetypeset
trigger1 = parent,ID = root,ID
trigger1 = ishelper
trigger1 =!(root,numprojID(1000045) && root,numprojID(1000046))
trigger1 =!hitpausetime;
statetype = C
movetype = A;攻擊狀態
ignorehitpause = 1

[state ,凍結獲取];取得凍結,以進行512溢出刷值
type = hitdef
trigger1 = parent,ID = root,ID
trigger1 = ishelper
trigger1 =!(root,numprojID(1000045) && root,numprojID(1000046))
trigger1 =!hitpausetime
attr = ,HP
pausetime = 4,0
numhits = 0
sparkno = -1
hitsound = -1
ignorehitpause = 1

[State 444444, 敌状态锁A确保获取HitPauseTime]
Type = StateTypeSet
Trigger1 = !IsHelper
Trigger1 = Name != "Nether"
StateType = S
MoveType = A
Physics = N
IgnoreHitPause = 1

[State 444444, 超即死投用敌人攻击动画]
Type = ChangeAnim2
Trigger1 = !IsHelper
Trigger1 = Name != "Nether"
Value = 9812
IgnoreHitPause = 1

[State 444444, 可攻击到敌方]
Type = HitBy
Trigger1 = !IsHelper
Trigger1 = Name != "Nether"
Value = SCA,AA,AP,AT
IgnoreHitPause = 1

[State 444444, 敌速度锁为0]
Type = VelSet
Trigger1 = !IsHelper
Trigger1 = Name != "Nether"
X = 0
Y = 0
IgnoreHitPause = 1

[State 444444, 敌所处高度锁为0]
Type = PosSet
Trigger1 = !IsHelper
Trigger1 = Name != "Nether"
Y = 0
IgnoreHitPause = 1

[State 444444, 落下即死]
Type = HitFallDamage
Trigger1 = !IsHelper
Trigger1 = Name != "Nether"
IgnoreHitPause = 1

[State 444444, 敌生命锁]
Type = LifeSet
Trigger1 = !IsHelper
Trigger1 = Name != "Nether"
Value = 0
IgnoreHitPause = 1

[State 444444, 当身]
Type = ReversalDef
Trigger1 = !IsHelper
Trigger1 = Name != "Nether"
Reversal.Attr = SCA,AA,AT,AP
NumHits = 0
SparkNo = -1
HitSound = -1
PauseTime = 4+Random%17,0
IgnoreHitPause = 1

[State 444444, HitDef呼出]
Type = HitDef
Trigger1 = !IsHelper
Trigger1 = Name != "Nether"
Attr = ,AA,AT,AP
HitFlag = MAFD
GuardFlag = 
GetPower = 0,0
GivePower = 0,0
AffectTeam = B
AnimType = Light
Priority = 7,Hit
Damage = 0,0
PauseTime = 4+Random%17,0
SparkNo = -1
Guard.SparkNo = -1
SparkXy = 0,0
HitSound = -1
GuardSound = -1
Ground.Type = High
NumHits = 0
IgnoreHitPause = 1

;敌本体变数弄
[State 444444, VarSet]
Type = VarSet
Trigger1 = !IsHelper && Name != "Nether"
var(0) = Ifelse(Random%2,Root,LifeMax*Ifelse(Random%2,Random,Random%2147483647),Random+Random%2147483647)
IgnoreHitPause = 1

