projedgebound = 100000000
projstagebound = 100000000
projheightbound = -100000000, 100000000
air.juggle = ifelse(root,const(data.airjuggle) < 0,2147483647,0)
supermovetime = 2147483647
pausemovetime = 2147483647
ignorehitpause = 1

