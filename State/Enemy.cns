trigger1 = (var(0) := var(0) + 1) * 0 || selfanimexist(var(0))=0
trigger1 = (var(0) := var(0) + 1) * 0 || selfanimexist(var(0))=0
trigger1 = (var(0) := var(0) + 1) * 0 || selfanimexist(var(0))=0
trigger1 = (var(0) := var(0) + 1) * 0 || selfanimexist(var(0))=0
trigger1 = (var(0) := var(0) + 1) * 0 || selfanimexist(var(0))=0
trigger1 = (var(0) := var(0) + 1) * 0 || selfanimexist(var(0))=0
trigger1 = (var(0) := var(0) + 1) * 0
;上面的條件是什麼意思?
;首先，"var(x) := y"這樣的條件指的是將"y"這個值代入var(x)(類似varset)
;也就是說，這裡是將var(0)+1給代入var(0),使var(0)一直+1
;然後，將其加上()並乘以0，使這個條件永遠為0
;"||"代表"or"，也就是前後擇一成立，由於前面的"(var(0) := var(0) + 1) * 0"絕對為0，所以由後面來決定條件是否成立
;selfanimexist(X),指的是當X號動畫存在時此條件成立，這裡是= 0，也就是指動畫不存在時成立

;明明是動畫探查，卻要等動畫不存在時觸發?
;別急，事實上是這樣的:
;MUGEN的條件讀取呢，是依照"triggerall→trigger1→trigger2→..."這樣的順序讀取的
;然後，一旦當"triggerX"不成立時，在這之下的所有"triggerX"都不會被讀取，接著讀取"triggerX+1"
;順便一提，當triggerall不成立時，在其以下的所有trigger都不會被讀取

;基於此來重新看一遍上面的條件，當var(0)號動畫不存在時，selfanimexist(var(0))=0成立
;由於前一trigger1成立，MUGEN便接著讀取下一個trigger1，並因(var(0) := var(0) + 1) * 0使得var(0)+1
;並再次使用selfanimexist(var(0))=0檢查增加1的var(0)號動畫是否存在
;如果不存在，則繼續讀取下一個trigger1，以此類推
;當var(0)號動畫存在時，即當selfanimexist(var(0))=1時，trigger1便不成立了
;也就是說將不會繼續讀取剩餘的trigger1，而轉為讀取trigger2
trigger2 = selfanimexist(var(0))
trigger2 = var(1) := 5
;當var(0)號動畫存在時，將5代入var(1)
;還請記得這個控制器最上方的"triggerall = ((var(1) := var(1) - (var(1) > 0)) * 0) && 0"這個條件
;這條件的意思是指當var(1)>0成立時就將var(1)減去1（(var(1)>0)成立時返回1，不成立時返回0）
;也就是說當var(0)號動畫存在時將var(1)設定為5，之後每1幀減少1，直到為0為止
;當var(1)>0時，在下面的triggerall = var(1)=0便不成立了，也就不會讀取以下的所有條件
;簡單來說，當檢索到存在的動畫時，探查便會停止5幀；而這5幀便用來播放檢索到的動畫，調查是否有攻擊框存在
ignorehitpause = 1


[State , 長時間的Anim變更]
type = Changeanim
trigger1 = ishelper(777777777)
trigger1 =!var(2);還未確定攻擊框存在時
trigger1 = animelemtime(1) > 5
value = anim
ignorehitpause = 1

[State , 變更為檢索到的動畫]
type = Changeanim
triggerall = ishelper(777777777)
triggerall =!var(2)
triggerall = selfanimexist(var(0))
triggerall = anim != var(0)
trigger1 = var(1)
value = var(0) * (var(0) != 5300)
ignorehitpause = 1

[State , 檢索重置]
type = Varset
trigger1 = ishelper(777777777)
trigger1 =!var(2)
trigger1 = var(0) > 1000000000
var(0) = 0
ignorehitpause = 1

[State , 確定紅框用Hitdef]
type = Hitdef
trigger1 = ishelper(777777777)
trigger1 =!var(2)
numhits = 0
attr = , HP
hitflag = MAFDLP
sparkno = -1
guard.sparkno = -1
pausetime = 2, 0;重要，以獲得打擊暫停判斷動畫是否有攻擊框
ignorehitpause = 1

[state ];狀態變更
type = Statetypeset
trigger1 = ishelper(777777777)
trigger1 =!var(2)
Statetype = C
Movetype = A;攻擊
IgnoreHitPause = 1

[state ]
type = Statetypeset
trigger1 = ishelper(777777777)
trigger1 =!!var(2);確定攻擊框後，anim探查完成
Movetype = I;閒置
IgnoreHitPause = 1

;返返返!
[State State返指定];playerid被記錄在我方本體fvar(5)的helper為各種狀態號的儲藏庫，且對於間者而言必須使用enemy重定向才是我方本體
type=null
triggerall = var(16):= -1;state返重置
trigger1 = ceil(enemy,fvar(1))%5000 = [0,199];(超)即死返
trigger1 = !!playerid(enemy,fvar(5)),var(2);當探查到敵方即死狀態號時
trigger1 = var(16):= ifelse(!!playerid(enemy,fvar(5)),var(0)&&root,hitpausetime > 1,playerID(ceil(enemy,fvar(5))),var(0+Random%(playerID(ceil(enemy,fvar(5))),var(11))),playerID(ceil(enemy,fvar(5))),var(2+Random%(playerID(ceil(enemy,fvar(5))),var(12))))
;當探測到敵方超即死狀態號時(playerid(enemy,fvar(5)),var(0)存在)並且敵方本體處於凍結(root,hitpausetime > 1)時使用超即死返
;若未達成以上條件則使用即死返
trigger2 = ceil(enemy,fvar(1))%5000 = [200,399];裝甲貫通
trigger2 = var(16):= ifelse(root,gethitvar(fall.damage),ifelse(random%2,5100,5110),ifelse(random%2,110+(random%2)*5,ifelse(random%2,6266,ifelse(random%2,1028,5210))))
;當敵方本體存在落下傷害時返送落下狀態號，若不存在時則返送可能有hitby的狀態號使敵方被打中而得到落下傷害
trigger3 = ceil(enemy,fvar(1))%5000 = [400,599];亞由亞由
trigger3 = var(16):= ifelse((!!playerid(enemy,fvar(5)),var(2))*(random%3 = 0),playerID(ceil(enemy,fvar(5))),var(2+Random%(playerID(ceil(enemy,fvar(5))),var(12))),ifelse(random%2,random*99999,ifelse(random%2,150,139)))
;透過使敵方返回不存在的或是特定的state使敵方的movetype = H
;當movetype= H時，-2 -3下的lifeset效果便會因為執行順序的緣故而被覆蓋掉，配合大傷害便可即死敵方
;這裡使用的有即死state亞由亞由、未使用state亞由亞由及防禦state亞由亞由
trigger4 = ceil(enemy,fvar(1))%5000 = [600,799];5900返
;某些人物可能在5900有漏洞(效用有限)
trigger4 = var(16):= 5900
trigger5 = ceil(enemy,fvar(1))%5000 = [800,999];helper state返
;某些人物可能在helper的狀態號存在hitby或hitdef之類的控制器，返送到這些狀態號即可對敵方造成殺傷
trigger5 = var(16):= playerID(ceil(enemy,fvar(5))),var(13+(Random%playerID(ceil(enemy,fvar(5))),var(31)))
trigger6 = ceil(enemy,fvar(1))%5000 = [1000,1199];攻擊受擊anim返
;原理同上，皆是為敵方可能存在漏洞的狀態號
trigger6 = var(16):= ifelse(gametime%2,var(2),playerID(ceil(enemy,fvar(9))),var(2))
trigger7 = ceil(enemy,fvar(1))%5000 = [1200,1399];間接落下即死
;對於某些處於倒地狀態(5100 5110)即脫離的人物來說，返送到正在下落的狀態便可使對方無法脫離
trigger7 = GameTime%4 = 0
trigger7 = var(16):= ifelse(root,gethitvar(fall.damage),ifelse(random%2,5071,5081),110+(random%2)*5)
trigger8 = ceil(enemy,fvar(1))%5000 = [1400,1599];sysvar弄
;存在操作系統變量的varadd或varset的狀態號，對於某些使用系統變量管理重要數據的角色可以用這種方法來影響(效果有限)
trigger8 = GameTime%5 = 0
trigger8 = var(16):= ifelse(random%2,ifelse(random%2,ifelse(random%2,40,45),50),5080)
trigger9 = ceil(enemy,fvar(1))%5000 = [1600,1799];hitdef state返
;返送到一般角色都會有的hitdef狀態號
trigger9 = GameTime%6 = 0
trigger9 = var(16):= ifelse(random%2,ifelse(random%2,200,400),600)
trigger10 = ceil(enemy,fvar(1))%5000 = [1800,1999];51返
;回歸行動，返到通常有ctrl = 1的狀態號，使敵方不會卡在奇怪的狀態號裡從而影響接下來的殺傷
trigger10 = var(16):= 51+random%2

[State , state返]
type = Projectile
trigger1 = ishelper(777777777)
trigger1 = root,alive
trigger1 = var(16) > -1
trigger1 =!!var(2);探查到攻擊框anim
attr = C,HP
projid = 999
projanim = var(2);使用探查到的動畫
projpriority = 7
