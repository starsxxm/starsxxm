trigger1 = ishelper(777777778)
trigger1 =!var(2) 
trigger1 = var(0) > 1000000000
var(0) = 0
ignorehitpause = 1

;helperID重定向偽裝-helper召喚
[State ]
type = Helper
trigger1 = enemy,var(11) > 0;
trigger1 = ishelper(777777778)
trigger1 = enemy,numhelper(20000) = 0
trigger1 = numhelper(enemy,var(11)) < 2
triggerall = playeridexist(id)
triggerall = roundstate < 3
ID = enemy,var(11)
name = "spy"
postype = p1
pos = 0,0
stateno = 1000 * random
helpertype = normal
size.xscale = 0
size.yscale = 0
keyctrl = 0
supermovetime = 9999999999999
pausemovetime = 9999999999999
ignorehitpause = 1

[State ]
type = Helper
trigger1 = enemy,var(12) > 0
trigger1 = ishelper(777777778)
trigger1 = numhelper(enemy,var(12)) < 2
trigger1 = enemy,numhelper(20001) = 0
triggerall = playeridexist(id)
triggerall = roundstate < 3
ID = enemy,var(12)
name = "spy"
postype = p1
pos = 0,0
stateno = 1000 * random
helpertype = normal
size.xscale = 0
size.yscale = 0
keyctrl = 0
supermovetime = 9999999999999
pausemovetime = 9999999999999
ignorehitpause = 1

[State ]
type = Helper
trigger1 = enemy,var(13) > 0
trigger1 = ishelper(777777778)
trigger1 = numhelper(enemy,var(13)) < 2
trigger1 = enemy,numhelper(20002) = 0
triggerall = playeridexist(id)
triggerall = roundstate < 3
ID = enemy,var(13)
name = "spy"
postype = p1
pos = 0,0
stateno = 1000 * random
helpertype = normal
size.xscale = 0
size.yscale = 0
keyctrl = 0
supermovetime = 9999999999999
pausemovetime = 9999999999999
ignorehitpause = 1

[State ]
type = Helper
trigger1 = enemy,var(14) > 0
trigger1 = ishelper(777777778)
trigger1 = enemy,numhelper(20003) = 0
trigger1 = numhelper(enemy,var(14)) < 2
triggerall = playeridexist(id)
triggerall = roundstate < 3
ID = enemy,var(14)
name = "spy"
postype = p1
pos = 0,0
stateno = 1000 * random
helpertype = normal
size.xscale = 0
size.yscale = 0
keyctrl = 0
supermovetime = 9999999999999
pausemovetime = 9999999999999
ignorehitpause = 1

[State ]
type = Helper
trigger1 = enemy,var(15) > 0
trigger1 = ishelper(777777778)
trigger1 = numhelper(enemy,var(15)) < 2
trigger1 = enemy,numhelper(20004) = 0
triggerall = playeridexist(id)
triggerall = roundstate < 3
ID = enemy,var(15)
name = "spy"
postype = p1
pos = 0,0
stateno = 1000 * random
helpertype = normal
size.xscale = 0
size.yscale = 0
keyctrl = 0
supermovetime = 9999999999999
pausemovetime = 9999999999999
ignorehitpause = 1

[State ];自毀
type = destroyself
trigger1 = ishelper
trigger1 = enemy,fvar(1) > 20000;2萬幀後混線解除
ignorehitpause = 1

;當對方有使用helper(xxx),xxx這類的條件時，用於偽裝對方存在的helper進行各種操作
;當存在兩個以上helperID相同的helper時，MUGEN會優先選擇上方的helper
;因此混線結構必須要先預留位置給偽裝用的heper，使偽裝helper的位置必定在原helper的上方

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;helperID重定向伪装
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[statedef 777777779]
type = U
movetype= U 
physics = U
ctrl = 0

[State ]
type = ChangeState
trigger1 =!parent,ishelper(777777778)
value = 515000
ignorehitpause = 1

[State ]
type = AssertSpecial
trigger1 = parent,ishelper(777777778)
flag = Invisible
flag2 = noshadow
ignorehitpause = 1

[State ]
type = ChangeState
trigger1 =!ishelper
value = ifelse(hitpausetime < 2,1000043,1000044)
ignorehitpause = 1

;裝甲偽裝，轉為受擊anim
[State ]
type = Changeanim
triggerall = parent,ishelper(777777778)
triggerall =!!playerID(ceil(enemy,fvar(9))),var(2)
trigger1 = enemy,var(11)>0
trigger1 = ishelper(enemy,var(11))
trigger2 = enemy,var(12)>0
trigger2 = ishelper(enemy,var(12))
trigger3 = enemy,var(11)>0
trigger3 = ishelper(enemy,var(13))
trigger4 = enemy,var(14)>0
trigger4 = ishelper(enemy,var(14))
trigger5 = enemy,var(15)>0
trigger5 = ishelper(enemy,var(15))
value = playerID(ceil(enemy,fvar(9))),var(2)
ignorehitpause=1

;若未探查到受擊anim則使用我方的受擊anim
[State ]
type = Changeanim2
triggerall = parent,ishelper(777777778)
triggerall =!playerID(ceil(enemy,fvar(9))),var(2)
trigger1 = enemy,var(11)>0
trigger1 = ishelper(enemy,var(11))
trigger2 = enemy,var(12)>0
trigger2 = ishelper(enemy,var(12))
trigger3 = enemy,var(11)>0
trigger3 = ishelper(enemy,var(13))
trigger4 = enemy,var(14)>0
trigger4 = ishelper(enemy,var(14))
trigger5 = enemy,var(15)>0
trigger5 = ishelper(enemy,var(15))
value = 20001
ignorehitpause=1

;可被打中的類型
[State ]
type = hitby
triggerall = parent,ishelper(777777778)
trigger1 = enemy,var(11)>0
trigger1 = ishelper(enemy,var(11))
trigger2 = enemy,var(12)>0
trigger2 = ishelper(enemy,var(12))
trigger3 = enemy,var(11)>0
trigger3 = ishelper(enemy,var(13))
trigger4 = enemy,var(14)>0
trigger4 = ishelper(enemy,var(14))
trigger5 = enemy,var(15)>0
trigger5 = ishelper(enemy,var(15))
value = SCA,AA,AP
ignorehitpause = 1

[State ]
type = destroyself
trigger1 = ishelper
trigger1 = enemy,fvar(1) > 20000;2萬幀後混線解除
ignorehitpause = 1

[state , 變數弄]
type = changestate
trigger1 = ishelper
trigger1 = ceil(enemy,fvar(1))%5000 = [4000,4999]
value = 777777780
ignorehitpause = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;helperID重定向伪装-变数弄
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[statedef 777777780]
type = U
movetype = U
physics = U
hitdefpersist = 1
movehitpersist = 1

[State ]
type = ChangeState
trigger1 =!parent,ishelper(777777778)
value = 515000
ignorehitpause = 1

;以速度來確定變數弄的變量
[state ];速度清零
type = velset
trigger1 = ishelper
trigger1 = stateno-prevstateno;當還未開始或60個變量都瀏覽完成時
Y = 0
ignorehitpause = 1

[state ];helper變數弄(整數)
type = null
triggerall = ishelper
triggerall = roundstate = 2
triggerall = floor(vel Y)=[0,59]
trigger1 = ceil(enemy,fvar(1))%5000 = [4000,4124];±極大值 or ±lifemax
trigger1 = 1 || var(floor(vel Y)) := ifelse(random%2,ifelse(random%2,root,lifemax,-root,lifemax),ifelse(random%2,2147483647,-2147483648))
trigger2 = ceil(enemy,fvar(1))%5000 = [4125,4249];0 or 1
trigger2 = 1 || var(floor(vel Y)) := random%2
trigger3 = ceil(enemy,fvar(1))%5000 = [4250,4374];lifemax add or lifemax sub or powermax add or powermax sub
trigger3 = playerIDexist(ceil(enemy,fvar(7)))
trigger3 = 1 || var(floor(vel Y)) := playerID(ceil(enemy,fvar(7))),var(floor(vel y)) + ifelse(random%2,ifelse(random%2,root,lifemax,-root,lifemax),ifelse(random%2,root,powermax,-root,powermax))
trigger4 = ceil(enemy,fvar(1))%5000 = [4375,4499];random or ±powermax
trigger4 = 1 || var(floor(vel Y)) := ifelse(random%3 = 0,random,ifelse(random%2,root,powermax,-root,powermax))
trigger5 = ceil(enemy,fvar(1))%5000 = [4500,4624];純位數
trigger5 = 1 || var(floor(vel Y)) := 111111111*(1 + (random%9))
trigger6 = ceil(enemy,fvar(1))%5000 = [4625,4749];random
trigger6 = 1 || var(floor(vel Y)) := random
trigger7 = ceil(enemy,fvar(1))%5000 = [4750,4874];allreset
trigger7 = 1 || var(floor(vel Y)) := 0
trigger8 = ceil(enemy,fvar(1))%5000 = [4875,4999];gametime
trigger8 = 1 || var(floor(vel Y)) := gametime + 1
ignorehitpause = 1

[state ];helper變數弄(浮點數)
type = null
triggerall = ishelper
triggerall = roundstate = 2
triggerall = floor(vel Y)=[0,39]
trigger1 = ceil(enemy,fvar(1))%5000 = [4000,4124];±極大值 or ±lifemax
trigger1 = 1 || fvar(floor(vel Y)):= ifelse(random%2,ifelse(random%2,root,lifemax,-root,lifemax),ifelse(random%2,2147483647,-2147483648))
trigger2 = ceil(enemy,fvar(1))%5000 = [4125,4249];0 or 1
trigger2 = 1 || fvar(floor(vel Y)):= random%2
trigger3 = ceil(enemy,fvar(1))%5000 = [4250,4374];lifemax add or lifemax sub or powermax add or powermax sub
trigger3 = playerIDexist(ceil(enemy,fvar(7)))
trigger3 = 1 || fvar(floor(vel Y)):= playerID(ceil(enemy,fvar(7))),fvar(floor(vel y)) + ifelse(random%2,ifelse(random%2,root,lifemax,-root,lifemax),ifelse(random%2,root,powermax,-root,powermax))
trigger4 = ceil(enemy,fvar(1))%5000 = [4375,4499];random or ±powermax
trigger4 = 1 || fvar(floor(vel Y)):= ifelse(random%3 = 0,random,ifelse(random%2,root,powermax,-root,powermax))
trigger5 = ceil(enemy,fvar(1))%5000 = [4500,4624];魔法數
trigger5 = 1 || fvar(floor(vel Y)):= (9999.0**9999)-(9999.0**9999)
trigger6 = ceil(enemy,fvar(1))%5000 = [4625,4749];:±∞・非數
trigger6 = 1 || fvar(floor(vel Y)):= ifelse(random%3 = 0,abs((9999.0**9999)-(9999.0**9999)),ifelse(random%2,9999.0**9999,-9999.0**9999))
trigger7 = ceil(enemy,fvar(1))%5000 = [4750,4874];allreset
trigger7 = 1 || fvar(floor(vel Y)):= 0
trigger8 = ceil(enemy,fvar(1))%5000 = [4875,4999];gametime
trigger8 = 1 || fvar(floor(vel Y)):= gametime + 1
ignorehitpause = 1

;helper sysvar弄
[State ]
type = VarSet
trigger1 = ishelper
trigger1 = roundstate = 2
trigger1 = floor(vel Y)=[0,4];系統變量只有0到4
sysvar(floor(vel Y)) = var(floor(vel Y))
ignorehitpause=1

[State ]
type = VarSet
trigger1 = ishelper
trigger1 = roundstate = 2
trigger1 = floor(vel Y)=[0,4]
sysfvar(floor(vel Y)) = fvar(floor(vel Y))
ignorehitpause=1

[state ];瀏覽下一個變量
type = veladd
trigger1 = ishelper
Y = 1
ignorehitpause = 1

[state ];迴圈瀏覽
type = changestate
trigger1 = ishelper
trigger1 = vel Y<=59;當還未瀏覽完成時
value = stateno
persistent = 256
ignorehitpause = 1

[state ]
type = changestate
trigger1 = ishelper
trigger1 = ceil(enemy,fvar(1))%5000 = [4990,4999]
value = 777777781
ignorehitpause = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;helperID重定向伪装-变数弄修复
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[statedef 777777781]
type = U
movetype = U
physics = U
hitdefpersist = 1
movehitpersist = 1

[State ]
type = ChangeState
trigger1 =!parent,ishelper(777777778)
value = 515000
ignorehitpause = 1

;以速度來確定變數弄的變量
[state ];速度清零
type = velset
trigger1 = ishelper
trigger1 = stateno-prevstateno;當還未開始或60個變量都瀏覽完成時
Y = 0
ignorehitpause = 1

[State ]
type = VarSet
trigger1 = ishelper
trigger1 = floor(vel Y) = [0,4]
sysvar(floor(vel Y)) = 0
ignorehitpause=1

[State ]
type = VarSet
trigger1 = ishelper
trigger1 = floor(vel Y) = [0,4]
sysfvar(floor(vel Y)) = 0

[state ];瀏覽下一個變量
type = veladd
trigger1 = ishelper
Y = 1
ignorehitpause = 1

[state ];迴圈瀏覽
type = changestate
trigger1 = ishelper
trigger1 = vel Y<=59;當還未瀏覽完成時
value = stateno
persistent = 256
ignorehitpause = 1

[State ]
type = VarRangeSet
trigger1 = roundstate = 2
trigger1 = ishelper
value = 0
ignorehitpause = 1

[State ]
type = VarRangeSet
trigger1 = roundstate = 2
trigger1 = ishelper
fvalue = 0
ignorehitpause = 1

[state ]
type = changestate
trigger1 = roundstate = 2
trigger1 = ishelper
trigger1 = ceil(enemy,fvar(1))%5000!= [4000,4999]
value = 777777779
ignorehitpause = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;hitpausetime獲得
;當處於凍結時MUGEN將只會讀取ignorehitpause = 1的控制器
;因此可利用這個特性來達到突破512限制的效果
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Statedef 1000043]
type = U
movetype = A
physics = N
ctrl = 0

[State ]
type = ChangeState
trigger1 = ishelper
value = 515000
ignorehitpause = 1

[state , explod消除，避免出現問題]
type = Removeexplod
trigger1 = 1
ignorehitpause = 1

[state , 當進來的是helper則自毀]
type = DestroySelf
trigger1 = 1
ignorehitpause = 1

[state , Changeanim2]
type = Changeanim2
trigger1 = 1
value = 10001;我方的攻擊框動畫，配合下方的hitdef獲取hitpausetime
ignorehitpause = 1

[state , hitpausetime獲得用HitDef]
type = HitDef
trigger1 = 1
attr = ,NA
hitflag = MAF
guardflag =
damage = 0,0
pausetime = 20,0
affectteam = B
sparkno = -1
guard.sparkno = -1
ignorehitpause = 1

[state ,即死]
type = lifeset
trigger1 =!ishelper
value = 0
ignorehitpause = 1

[state , 死亡後返回]
type = selfState
trigger1 =!alive
value = 5150
ignorehitpause = 1

[state , 獲取凍結後轉入超即死狀態號]
type = ChangeState
trigger1 =!ishelper
trigger1 = hitpausetime > 1
value = 1000044
ignorehitpause = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;超即死
;透過512控制器溢出將敵方處於553-556位置的Alive刷為0，從而即死敵方
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Statedef 1000044];1000044
type = U
movetype = U
physics = N
ctrl = 0

[state ,保險]
type = Selfstate
trigger1 = name = "Nether";當自己進來時
value = sysvar(4);回歸上一個狀態號
ignorehitpause = 1
[state ]
type = Removeexplod
trigger1 = 1
ignorehitpause = 1
[state ]
type = Nothitby
trigger1 = 1
value = SCA
ignorehitpause = 1
[state ]
type = lifeset
trigger1 =!ishelper
value = 0
ignorehitpause = 1
[state ]
type = null;Pause
triggerall =!ishelper
trigger1 =!alive
time = 2
movetime = 2
ignorehitpause = 1
[state ]
type = null;Superpause
triggerall =!ishelper
trigger1 =!alive
anim = -1
time = 2
movetime = 2
darken = 0
p2defmul = 1
ignorehitpause = 1
[state ];當凍結快結束時返回繼續獲取hitpausetime，避免512錯誤
type = ChangeState
trigger1 = hitpausetime < 2
value = 1000043
ignorehitpause = 1
