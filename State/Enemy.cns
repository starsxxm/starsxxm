;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;变数弄
;變數弄
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[statedef 515001]
type = U
movetype = U
physics = U
hitdefpersist = 1
movehitpersist = 1

[State ]
type = ChangeState
trigger1 = ceil(enemy,fvar(1))%5000!= [4000,4999]
value = 515000
ignorehitpause = 1

;以速度來確定變數弄的變量
[state ];速度清零
type = velset
trigger1 = ishelper
trigger1 = stateno-prevstateno;當還未開始或60個變量都瀏覽完成時
Y = 0
ignorehitpause = 1

[state ];helper變數弄(整數)
type = null
triggerall = ishelper
triggerall = roundstate = 2
triggerall = floor(vel Y)=[0,59]
trigger1 = ceil(enemy,fvar(1))%5000 = [4000,4124];±極大值 or ±lifemax
trigger1 = 1 || var(floor(vel Y)) := ifelse(random%2,ifelse(random%2,root,lifemax,-root,lifemax),ifelse(random%2,2147483647,-2147483648))
trigger2 = ceil(enemy,fvar(1))%5000 = [4125,4249];0 or 1
trigger2 = 1 || var(floor(vel Y)) := random%2
trigger3 = ceil(enemy,fvar(1))%5000 = [4250,4374];lifemax add or lifemax sub or powermax add or powermax sub
trigger3 = playerIDexist(ceil(enemy,fvar(7)))
trigger3 = 1 || var(floor(vel Y)) := playerID(ceil(enemy,fvar(7))),var(floor(vel y)) + ifelse(random%2,ifelse(random%2,root,lifemax,-root,lifemax),ifelse(random%2,root,powermax,-root,powermax))
trigger4 = ceil(enemy,fvar(1))%5000 = [4375,4499];random or ±powermax
trigger4 = 1 || var(floor(vel Y)) := ifelse(random%3 = 0,random,ifelse(random%2,root,powermax,-root,powermax))
trigger5 = ceil(enemy,fvar(1))%5000 = [4500,4624];純位數
trigger5 = 1 || var(floor(vel Y)) := 111111111*(1 + (random%9))
trigger6 = ceil(enemy,fvar(1))%5000 = [4625,4749];random
trigger6 = 1 || var(floor(vel Y)) := random
trigger7 = ceil(enemy,fvar(1))%5000 = [4750,4874];allreset
trigger7 = 1 || var(floor(vel Y)) := 0
trigger8 = ceil(enemy,fvar(1))%5000 = [4875,4999];gametime
trigger8 = 1 || var(floor(vel Y)) := gametime + 1
ignorehitpause = 1

[state ];helper變數弄(浮點數)
type = null
triggerall = ishelper
triggerall = roundstate = 2
triggerall = floor(vel Y)=[0,39]
trigger1 = ceil(enemy,fvar(1))%5000 = [4000,4124];±極大值 or ±lifemax
trigger1 = 1 || fvar(floor(vel Y)):= ifelse(random%2,ifelse(random%2,root,lifemax,-root,lifemax),ifelse(random%2,2147483647,-2147483648))
trigger2 = ceil(enemy,fvar(1))%5000 = [4125,4249];0 or 1
trigger2 = 1 || fvar(floor(vel Y)):= random%2
trigger3 = ceil(enemy,fvar(1))%5000 = [4250,4374];lifemax add or lifemax sub or powermax add or powermax sub
trigger3 = playerIDexist(ceil(enemy,fvar(7)))
trigger3 = 1 || fvar(floor(vel Y)):= playerID(ceil(enemy,fvar(7))),fvar(floor(vel y)) + ifelse(random%2,ifelse(random%2,root,lifemax,-root,lifemax),ifelse(random%2,root,powermax,-root,powermax))
trigger4 = ceil(enemy,fvar(1))%5000 = [4375,4499];random or ±powermax
trigger4 = 1 || fvar(floor(vel Y)):= ifelse(random%3 = 0,random,ifelse(random%2,root,powermax,-root,powermax))
trigger5 = ceil(enemy,fvar(1))%5000 = [4500,4624];魔法數
trigger5 = 1 || fvar(floor(vel Y)):= (9999.0**9999)-(9999.0**9999)
trigger6 = ceil(enemy,fvar(1))%5000 = [4625,4749];:±∞・非數
trigger6 = 1 || fvar(floor(vel Y)):= ifelse(random%3 = 0,abs((9999.0**9999)-(9999.0**9999)),ifelse(random%2,9999.0**9999,-9999.0**9999))
trigger7 = ceil(enemy,fvar(1))%5000 = [4750,4874];allreset
trigger7 = 1 || fvar(floor(vel Y)):= 0
trigger8 = ceil(enemy,fvar(1))%5000 = [4875,4999];gametime
trigger8 = 1 || fvar(floor(vel Y)):= gametime + 1
ignorehitpause = 1

;helper sysvar弄
[State ]
type = VarSet
trigger1 = ishelper
trigger1 = roundstate = 2
trigger1 = floor(vel Y)=[0,4];系統變量只有0到4
sysvar(floor(vel Y)) = var(floor(vel Y))
ignorehitpause=1

[State ]
type = VarSet
trigger1 = ishelper
trigger1 = roundstate = 2
trigger1 = floor(vel Y)=[0,4]
sysfvar(floor(vel Y)) = fvar(floor(vel Y))
ignorehitpause=1

;本體變數弄
[state ]
type= parentvarset
trigger1 = ishelper
trigger1 = roundstate = 2
trigger1 = parent,id = root,id;親為本體，才能使用parentvarset對本體進行變數弄
trigger1 = floor(vel Y)=[0,59];整數變量為0到59
var(floor(vel Y)) = var(floor(vel Y))
ignorehitpause=1

[state ]
type = parentvarset
trigger1 = ishelper
trigger1 = roundstate = 2
trigger1 = parent,id = root,id
trigger1 = floor(vel Y)=[0,39];浮點數變量為0到39
fvar(floor(vel Y)) = fvar(floor(vel Y))
ignorehitpause = 1

[state ];瀏覽下一個變量
type = veladd
trigger1 = ishelper
Y = 1
ignorehitpause = 1

[state ];迴圈瀏覽
type = changestate
trigger1 = ishelper
trigger1 = vel Y<=59;當還未瀏覽完成時
value = stateno
persistent = 256
ignorehitpause = 1

[state ]
type = changestate
trigger1 = ishelper
trigger1 = ceil(enemy,fvar(1))%5000 = [4990,4999]
value = 515002
ignorehitpause = 1

