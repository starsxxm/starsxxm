;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;受击Anim取得间者
;受擊anim取得間者
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[statedef 777777778]
type = U
movetype = U
physics = U
hitdefpersist = 1
movehitpersist = 1

[State ];非受擊anim取得間者則轉回混線處理
type = ChangeState
trigger1 =!ishelper(777777778)
value = 515000
ignorehitpause = 1

[State ]
type = AssertSpecial
trigger1 = ishelper(777777778)
flag = Invisible
flag2 = noshadow
ignorehitpause = 1

[state ]
type = Statetypeset
trigger1 = ishelper(777777778)
Movetype = I;閒置
IgnoreHitPause = 1

[State , 受擊anim記憶]
type = Varset
triggerall = ishelper(777777778)
;triggerall =!enemy,var(30);本體還未記憶動畫
triggerall =!var(2);var(2)還未記憶動畫
trigger1 = gethitvar(damage);受到傷害 ＝ 被打中了 ＝ 有受擊框的anim
var(2) = anim
ignorehitpause = 1

[State ];裝甲，確保受擊後不會轉入奇怪的狀態號
type = HitOverRide
trigger1 = ishelper(777777778)
