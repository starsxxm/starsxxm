;变数修复
;變數修復
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[statedef 515002]
type = U
movetype = U
physics = U
hitdefpersist = 1
movehitpersist = 1

[State ]
type = ChangeState
trigger1 = ceil(enemy,fvar(1))%5000!= [4990,4999]
value = 515000
ignorehitpause = 1

;以速度來確定變數弄的變量
[state ];速度清零
type = velset
trigger1 = ishelper
trigger1 = stateno-prevstateno;當還未開始或60個變量都瀏覽完成時
Y = 0
ignorehitpause = 1

[state ];playerid被記錄在我方本體fvar(7)的helper為敵本體變數弄前變量的儲存庫，對於敵方helper而言必須使用enemy重定向才是我方本體
type= parentvarset
trigger1 = ishelper
trigger1 = parent,id = root,id
trigger1 = floor(vel Y) = [0,59];整數變量為0到59
var(floor(vel Y)) = playerID(ceil(enemy,fvar(7))),var(floor(vel Y))
ignorehitpause=1

[state ]
type = parentvarset
trigger1 = ishelper
trigger1 = parent,id = root,id
trigger1 = floor(vel Y) = [0,39];浮點樹變量為0到39
fvar(floor(vel Y)) = playerID(ceil(enemy,fvar(7))),fvar(floor(vel Y))
ignorehitpause = 1

